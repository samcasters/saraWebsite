#!/usr/bin/env python3
"""Numbered control panel for the MicroK8s cluster on this Pi.

Run it from your own SSH session:

    ~/k8s/panel
"""

import curses
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time

LOCKED_NAMESPACES = {"kube-system", "ingress"}
SYSTEM_NAMESPACES = {"kube-system", "kube-public", "kube-node-lease", "ingress"}
MAX_DEPLOYMENT_REPLICAS = 3
REFRESH_MS = 2000


def microk8s_bin():
    found = shutil.which("microk8s")
    if found:
        return found
    if os.path.exists("/snap/bin/microk8s"):
        return "/snap/bin/microk8s"
    return None


class Cluster:
    def __init__(self):
        self.binary = microk8s_bin()
        self.use_sg = False
        if not self.binary:
            return
        probe = subprocess.run(
            [self.binary, "kubectl", "get", "ns"],
            capture_output=True,
            text=True,
        )
        err = (probe.stderr or "") + (probe.stdout or "")
        self.use_sg = "Insufficient permissions" in err

    def available(self):
        return self.binary is not None

    def run(self, args, timeout=40, check=True):
        if not self.binary:
            raise RuntimeError("MicroK8s is not installed.")
        if self.use_sg:
            command = shlex.join([self.binary, *args])
            result = subprocess.run(
                ["sg", "microk8s", "-c", command],
                capture_output=True,
                text=True,
                timeout=timeout,
            )
        else:
            result = subprocess.run(
                [self.binary, *args],
                capture_output=True,
                text=True,
                timeout=timeout,
            )
        if check and result.returncode != 0:
            detail = (result.stderr or result.stdout or "command failed").strip()
            raise RuntimeError(detail)
        return result

    def json(self, args, timeout=40):
        result = self.run([*args, "-o", "json"], timeout=timeout)
        return json.loads(result.stdout or "{}")

    def visible(self, args, timeout=180):
        if not self.binary:
            raise RuntimeError("MicroK8s is not installed.")
        if self.use_sg:
            command = shlex.join([self.binary, *args])
            result = subprocess.run(["sg", "microk8s", "-c", command], timeout=timeout)
        else:
            result = subprocess.run([self.binary, *args], timeout=timeout)
        if result.returncode != 0:
            raise RuntimeError(f"The command exited {result.returncode}.")
        return 0


def compose_neo4j_running():
    args = ["ps", "-q", "--filter", "name=sara-neo4j", "--filter", "status=running"]
    direct = subprocess.run(["docker", *args], capture_output=True, text=True)
    text = direct.stdout if direct.returncode == 0 else ""
    if direct.returncode != 0:
        command = "docker " + shlex.join(args)
        via_sg = subprocess.run(["sg", "docker", "-c", command], capture_output=True, text=True)
        text = via_sg.stdout if via_sg.returncode == 0 else ""
    return bool(text.strip())


def selector_matches(selector, labels):
    if not selector:
        return False
    labels = labels or {}
    return all(labels.get(key) == value for key, value in selector.items())


def service_text(services, namespace, labels):
    matched = []
    for service in services:
        meta = service["metadata"]
        if meta["namespace"] != namespace:
            continue
        if not selector_matches(service["spec"].get("selector"), labels):
            continue
        ports = []
        for port in service["spec"].get("ports") or []:
            number = port.get("port")
            if number is None:
                continue
            ports.append((number, port.get("protocol") or "TCP"))
        numbers = [number for number, _ in ports]
        shown = []
        for number, protocol in ports:
            if numbers.count(number) > 1:
                shown.append(f"{number}/{protocol}")
            else:
                shown.append(str(number))
        port_text = ",".join(shown) if shown else "?"
        matched.append(f"{meta['name']}:{port_text}")
    return ", ".join(matched) if matched else "-"


def ingress_text(ingresses, namespace, service_names):
    if not service_names:
        return "-"
    hits = []
    for ingress in ingresses:
        meta = ingress["metadata"]
        if meta["namespace"] != namespace:
            continue
        for rule in (ingress["spec"] or {}).get("rules") or []:
            http = rule.get("http") or {}
            for path in http.get("paths") or []:
                backend = ((path.get("backend") or {}).get("service") or {})
                name = backend.get("name")
                if name not in service_names:
                    continue
                shown = path.get("path") or "/"
                port = ((backend.get("port") or {}).get("number"))
                port_text = f":{port}" if port else ""
                hits.append(f"{shown} -> {name}{port_text}")
    return ", ".join(hits) if hits else "-"


def service_names_for(services, namespace, labels):
    names = []
    for service in services:
        meta = service["metadata"]
        if meta["namespace"] != namespace:
            continue
        if selector_matches(service["spec"].get("selector"), labels):
            names.append(meta["name"])
    return names


def pod_ready(pod):
    statuses = pod["status"].get("containerStatuses") or []
    total = len(statuses) or len(pod["spec"].get("containers") or [])
    ready = sum(1 for status in statuses if status.get("ready"))
    return f"{ready}/{total}"


def pod_status(pod):
    for status in pod["status"].get("containerStatuses") or []:
        state = status.get("state") or {}
        if "waiting" in state:
            return state["waiting"].get("reason") or "Waiting"
        if "terminated" in state and pod["status"].get("phase") != "Succeeded":
            return state["terminated"].get("reason") or "Terminated"
    return pod["status"].get("phase") or "Unknown"


def node_ready(node):
    for condition in node["status"].get("conditions") or []:
        if condition.get("type") == "Ready":
            return "Ready" if condition.get("status") == "True" else "NotReady"
    return "Unknown"


def node_ip(node):
    for address in node["status"].get("addresses") or []:
        if address.get("type") == "InternalIP":
            return address.get("address") or "-"
    return "-"


def pad(text, width):
    """Pad short columns so they line up. Keep long text so left and right can scroll to it."""
    text = str(text)
    if len(text) >= width:
        return text + "  "
    return text.ljust(width)


def status_kind(text):
    if text in ("Running", "Ready", "Succeeded"):
        return "ok"
    if text in ("Pending", "ContainerCreating", "PodInitializing", "Terminating"):
        return "warn"
    bad_words = ("Error", "Fail", "BackOff", "NotReady", "Unknown", "OOM", "Crash", "Err", "Pull", "Invalid", "Evicted")
    if any(word in text for word in bad_words):
        return "bad"
    return ""


def pod_matches(pod, hide_system, needle):
    meta = pod["metadata"]
    if hide_system and meta["namespace"] in SYSTEM_NAMESPACES:
        return False
    if needle:
        blob = f"{meta['namespace']}/{meta['name']} {pod_status(pod)}".lower()
        if needle not in blob:
            return False
    return True


def pod_pieces(pod, services, ingresses):
    meta = pod["metadata"]
    labels = meta.get("labels") or {}
    namespace = meta["namespace"]
    names = service_names_for(services, namespace, labels)
    status = pod_status(pod)
    ready = pod_ready(pod)
    ready_kind = "ok" if ready.split("/")[0] == ready.split("/")[-1] and ready != "0/0" else "warn"
    return [
        (pad(f"{namespace}/{meta['name']}", 50), ""),
        (pad(ready, 7), ready_kind),
        (pad(status, 18), status_kind(status)),
        (pad(service_text(services, namespace, labels), 28), ""),
        (ingress_text(ingresses, namespace, names), ""),
    ]


def build_map(nodes, pods, services, ingresses, hide_system=False, query=""):
    by_node = {node["metadata"]["name"]: [] for node in nodes}
    waiting = []
    for pod in pods:
        name = pod["spec"].get("nodeName")
        if name and name in by_node:
            by_node[name].append(pod)
        else:
            waiting.append(pod)

    needle = query.strip().lower()
    lines = [[
        (pad("POD", 50), "bold"),
        (pad("READY", 7), "bold"),
        (pad("STATUS", 18), "bold"),
        (pad("SERVICE", 28), "bold"),
        ("INGRESS", "bold"),
    ]]
    if hide_system:
        lines.append([("Cluster pods are hidden. Press h to show them.", "dim")])
    if needle:
        lines.append([(f"Find: {query.strip()}", "dim")])

    shown = 0
    hidden = 0

    def take(group):
        nonlocal hidden
        kept = []
        for pod in group:
            if pod_matches(pod, hide_system, needle):
                kept.append(pod)
            else:
                hidden += 1
        return kept

    ordered = sorted(nodes, key=lambda item: item["metadata"]["name"])
    if not ordered and not waiting:
        lines.append("No nodes yet.")
        return lines

    for node in ordered:
        meta = node["metadata"]
        runtime = ((node["status"].get("nodeInfo") or {}).get("containerRuntimeVersion") or "-")
        group = sorted(by_node.get(meta["name"], []), key=lambda item: (
            item["metadata"]["namespace"], item["metadata"]["name"]
        ))
        matching = take(group)
        if not matching and (needle or hide_system):
            continue
        ready = node_ready(node)
        lines.append([("", "")])
        lines.append([
            (f"NODE {meta['name']}    ", "title"),
            (ready, "ok" if ready == "Ready" else "bad"),
            (f"    {node_ip(node)}    {runtime}", "dim"),
        ])
        if not matching:
            lines.append([("  no pods on this node", "dim")])
        for pod in matching:
            lines.append(pod_pieces(pod, services, ingresses))
            shown += 1

    matching_wait = take(sorted(waiting, key=lambda item: (
        item["metadata"]["namespace"], item["metadata"]["name"]
    )))
    if matching_wait:
        lines.append([("", "")])
        lines.append([("NODE (not scheduled)", "warn")])
        for pod in matching_wait:
            lines.append(pod_pieces(pod, services, ingresses))
            shown += 1

    lines.append([("", "")])
    lines.append([(f"{shown} pods shown, {hidden} hidden", "dim")])
    return lines


def scale_decision(kind, namespace, name, desired, compose_running):
    if namespace in LOCKED_NAMESPACES:
        return "locked", f"{namespace}/{name} belongs to the cluster itself and is not scaled here."
    if not isinstance(desired, int) or desired < 0:
        return "reject", "Type a whole number, 0 or more."
    if compose_running and "neo4j" in name and desired > 0:
        return "reject", "Compose is already running Neo4j. Stop it before starting that database in Kubernetes."
    if kind == "Deployment" and desired > MAX_DEPLOYMENT_REPLICAS:
        return "reject", f"This Pi keeps a Deployment at {MAX_DEPLOYMENT_REPLICAS} pods or fewer."
    if kind == "StatefulSet" and desired != 1:
        return "confirm", (
            "A StatefulSet gives each pod its own disk. "
            "More than one Neo4j pod is not a copy of the same database. Type YES to continue."
        )
    return "ok", ""


def workload_rows(deployments, statefulsets):
    rows = []
    for item in deployments.get("items") or []:
        meta = item["metadata"]
        rows.append({
            "kind": "Deployment",
            "name": meta["name"],
            "namespace": meta["namespace"],
            "replicas": item["spec"].get("replicas", 0),
            "ready": (item.get("status") or {}).get("readyReplicas", 0) or 0,
        })
    for item in statefulsets.get("items") or []:
        meta = item["metadata"]
        rows.append({
            "kind": "StatefulSet",
            "name": meta["name"],
            "namespace": meta["namespace"],
            "replicas": item["spec"].get("replicas", 0),
            "ready": (item.get("status") or {}).get("readyReplicas", 0) or 0,
        })
    rows.sort(key=lambda row: (row["namespace"] in LOCKED_NAMESPACES, row["namespace"], row["name"]))
    return rows


def pod_reason(pod):
    lines = [
        f"{pod['metadata']['namespace']}/{pod['metadata']['name']}",
        f"Node: {pod['spec'].get('nodeName') or 'not scheduled'}",
        f"Phase: {pod['status'].get('phase') or '-'}",
        f"Status: {pod_status(pod)}",
    ]
    for condition in pod["status"].get("conditions") or []:
        if condition.get("status") == "False" or condition.get("reason"):
            message = condition.get("message") or ""
            lines.append(
                f"{condition.get('type')}: {condition.get('status')} {condition.get('reason') or ''} {message}".rstrip()
            )
    for status in pod["status"].get("containerStatuses") or []:
        last = (status.get("lastState") or {}).get("terminated")
        if last:
            lines.append(
                f"Last exit {status.get('name')}: {last.get('reason') or '-'} "
                f"code {last.get('exitCode')} {last.get('message') or ''}".rstrip()
            )
    return lines


def warning_lines(events):
    rows = []
    for event in events.get("items") or []:
        if event.get("type") != "Warning":
            continue
        when = event.get("lastTimestamp") or event.get("eventTime") or ""
        involved = event.get("involvedObject") or {}
        who = f"{involved.get('namespace') or '-'}/{involved.get('name') or '-'}"
        rows.append((when, f"{when}  {who}  {event.get('reason') or '-'}  {event.get('message') or ''}"))
    rows.sort()
    return [line for _, line in rows[-30:]] or ["No warnings."]


def clip(text, width):
    if width <= 0:
        return ""
    return text[:width]


def as_pieces(line):
    if isinstance(line, str):
        return [(line, "")]
    return line


def line_length(line):
    return sum(len(text) for text, _kind in as_pieces(line))


USE_COLOR = False


def kind_attr(kind):
    if not USE_COLOR:
        if kind in ("title", "bold", "ok", "warn", "bad"):
            return curses.A_BOLD
        if kind == "dim":
            return curses.A_DIM
        return curses.A_NORMAL
    if kind == "title":
        return curses.color_pair(1) | curses.A_BOLD
    if kind == "ok":
        return curses.color_pair(2) | curses.A_BOLD
    if kind == "warn":
        return curses.color_pair(3) | curses.A_BOLD
    if kind == "bad":
        return curses.color_pair(4) | curses.A_BOLD
    if kind == "dim":
        return curses.A_DIM
    if kind == "bold":
        return curses.A_BOLD
    if kind == "accent":
        return curses.color_pair(1)
    return curses.A_NORMAL


def draw_pieces(stdscr, y, line, hscroll=0, reverse=False):
    height, width = stdscr.getmaxyx()
    if y < 0 or y >= height or width < 2:
        return
    limit = width - 1
    base = curses.A_REVERSE if reverse else 0
    try:
        if reverse:
            stdscr.addnstr(y, 0, " " * limit, limit, base)
        skip = hscroll
        x = 0
        for text, kind in as_pieces(line):
            if not text:
                continue
            if skip >= len(text):
                skip -= len(text)
                continue
            if skip:
                text = text[skip:]
                skip = 0
            room = limit - x
            if room <= 0:
                break
            shown = text[:room]
            stdscr.addnstr(y, x, shown, len(shown), kind_attr(kind) | base)
            x += len(shown)
        if not reverse:
            stdscr.move(y, min(x, limit))
            stdscr.clrtoeol()
    except curses.error:
        pass


def clear_terminal():
    """Blank the screen before ordinary command output is printed."""
    if not sys.stdout.isatty():
        return
    sys.stdout.write("\033[H\033[2J\033[3J")
    sys.stdout.flush()


def wrap_text(text, width):
    width = max(8, width)
    lines = []
    for paragraph in str(text).splitlines() or [""]:
        current = ""
        for word in paragraph.split():
            trial = word if not current else current + " " + word
            if len(trial) <= width:
                current = trial
                continue
            if current:
                lines.append(current)
            current = word
        lines.append(current)
    return lines or [""]


def prompt(stdscr, question):
    """Ask on the bottom line. Wait for Enter even if the screen was on a timer."""
    height, width = stdscr.getmaxyx()
    y = height - 1
    shown = clip(question, max(1, width - 8))
    stdscr.timeout(-1)
    try:
        curses.echo()
        curses.curs_set(1)
        stdscr.move(y, 0)
        stdscr.clrtoeol()
        stdscr.addnstr(y, 0, shown, width - 1)
        stdscr.refresh()
        raw = stdscr.getstr(y, min(len(shown) + 1, width - 2))
    except (KeyboardInterrupt, curses.error):
        return ""
    finally:
        curses.noecho()
        curses.curs_set(0)
    return raw.decode(errors="replace").strip()


def draw_note(stdscr, title, text):
    """Paint a short warning. The caller asks for the next key."""
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    draw_pieces(stdscr, 0, [(title, "title")])
    row = 2
    for line in wrap_text(text, max(8, width - 2)):
        if row >= height - 2:
            break
        draw_pieces(stdscr, row, [(line, "warn")])
        row += 1
    stdscr.refresh()


def show_note(stdscr, title, text):
    """Show a short warning on its own screen. Enter or q leaves it."""
    while True:
        draw_note(stdscr, title, text)
        height, _width = stdscr.getmaxyx()
        draw_pieces(stdscr, height - 1, [("Press Enter.", "dim")])
        stdscr.refresh()
        stdscr.timeout(-1)
        try:
            key = read_key(stdscr)
        except KeyboardInterrupt:
            return
        if key in (-1, curses.KEY_RESIZE):
            continue
        return


def read_key(stdscr):
    """Return one key. Join an xterm arrow that arrived as separate bytes.

    With a getch timeout, keypad mode leaves a right arrow as Escape, '[', 'C'
    instead of KEY_RIGHT. Treating that first byte as Escape would leave the
    screen. A bare Escape, with nothing after it, stays 27.
    The caller sets the timeout before each call. This waits a short time only
    for the bytes that follow Escape.
    """
    key = stdscr.getch()
    if key != 27:
        return key
    stdscr.timeout(40)
    second = stdscr.getch()
    if second < 0:
        return 27
    third = stdscr.getch()
    if third < 0:
        return 27
    if second in (ord("["), ord("O")):
        arrows = {
            ord("A"): curses.KEY_UP,
            ord("B"): curses.KEY_DOWN,
            ord("C"): curses.KEY_RIGHT,
            ord("D"): curses.KEY_LEFT,
        }
        if third in arrows:
            return arrows[third]
        if second == ord("[") and third == ord("5"):
            stdscr.getch()
            return curses.KEY_PPAGE
        if second == ord("[") and third == ord("6"):
            stdscr.getch()
            return curses.KEY_NPAGE
        if second == ord("[") and third == ord("H"):
            return curses.KEY_HOME
        if second == ord("[") and third == ord("F"):
            return curses.KEY_END
        if second == ord("[") and third == ord("1"):
            if stdscr.getch() == ord("~"):
                return curses.KEY_HOME
        if second == ord("[") and third == ord("4"):
            if stdscr.getch() == ord("~"):
                return curses.KEY_END
    stdscr.timeout(0)
    for _ in range(6):
        if stdscr.getch() < 0:
            break
    return -1


def screen_title(title):
    if isinstance(title, dict):
        return title.get("title") or ""
    return title


def scroll_screen(stdscr, title, lines, refresh=None, on_key=None, hint=None, start="top"):
    vscroll = 0 if start != "end" else 10 ** 9
    hscroll = 0
    fresh = True
    drawn = None
    hint = hint or "up/down move    left/right scroll    page up/down    q back    ? help"
    while True:
        height, width = stdscr.getmaxyx()
        if height < 6 or width < 24:
            stdscr.erase()
            draw_pieces(stdscr, 0, [("Make this terminal bigger. q goes back.", "warn")])
            stdscr.refresh()
            stdscr.timeout(-1)
            try:
                key = read_key(stdscr)
            except KeyboardInterrupt:
                return
            if key in (3, 27, ord("q"), ord("Q")):
                return
            drawn = None
            continue
        window = max(1, height - 3)
        # Stay at the bottom while new lines arrive, until the reader scrolls up.
        at_end = start == "end" and drawn is None
        if lines:
            at_end = vscroll >= max(0, len(lines) - window)
        if refresh and fresh:
            if drawn is None and not lines:
                stdscr.erase()
                draw_pieces(stdscr, 0, [(screen_title(title) or "Please wait", "title")])
                draw_pieces(stdscr, 2, [("Reading the cluster...", "dim")])
                stdscr.refresh()
            try:
                lines = refresh()
            except Exception as error:
                lines = [str(error).splitlines()[0] if str(error) else "The cluster did not answer."]
            if at_end:
                vscroll = 10 ** 9
        fresh = False
        widest = max((line_length(line) for line in lines), default=0)
        vscroll = max(0, min(vscroll, max(0, len(lines) - window)))
        hscroll = max(0, min(hscroll, max(0, widest - width + 1)))
        shown_hint = hint
        if hscroll or widest > width:
            shown_hint += f"    column {hscroll + 1}"
        last = min(vscroll + window, len(lines))
        footer = f"{min(vscroll + 1, len(lines))}-{last} of {len(lines)}" if lines else "empty"
        signature = (
            screen_title(title), shown_hint, footer, vscroll, hscroll, height, width,
            tuple(tuple(as_pieces(line)) for line in lines),
        )
        if signature != drawn:
            stdscr.erase()
            draw_pieces(stdscr, 0, [(screen_title(title), "title")])
            draw_pieces(stdscr, 1, [(shown_hint, "dim")])
            for offset in range(window):
                index = vscroll + offset
                if index < len(lines):
                    draw_pieces(stdscr, 2 + offset, lines[index], hscroll)
            draw_pieces(stdscr, height - 1, [(footer, "dim")])
            stdscr.refresh()
            drawn = signature
        stdscr.timeout(REFRESH_MS if refresh else -1)
        try:
            key = read_key(stdscr)
        except KeyboardInterrupt:
            return
        action = on_key(key) if on_key and key != -1 else None
        if action in ("refresh", "home"):
            if action == "home":
                vscroll = 0
                hscroll = 0
            fresh = True
            drawn = None
            continue
        if action == "close" or key in (3, 27, ord("q"), ord("Q")):
            return
        if key == -1:
            fresh = refresh is not None
            continue
        if key == ord("?"):
            help_screen(stdscr)
            drawn = None
            continue
        if key == curses.KEY_LEFT:
            hscroll = max(0, hscroll - 8)
        elif key == curses.KEY_RIGHT:
            hscroll += 8
        elif key in (curses.KEY_UP, ord("k")):
            vscroll = max(0, vscroll - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            vscroll += 1
        elif key in (curses.KEY_PPAGE, ord("b")):
            vscroll = max(0, vscroll - window)
        elif key in (curses.KEY_NPAGE, ord(" "), ord("f")):
            vscroll += window
        elif key in (curses.KEY_HOME, ord("g")):
            vscroll = 0
        elif key in (curses.KEY_END, ord("G")):
            vscroll = 10 ** 9
        elif key == ord("r") and refresh:
            fresh = True
            drawn = None
        elif key == curses.KEY_RESIZE:
            drawn = None


def suspend(stdscr, action):
    """Leave the panel, clear the terminal, then print the command's own text."""
    curses.def_prog_mode()
    curses.endwin()
    clear_terminal()
    error = None
    try:
        action()
    except KeyboardInterrupt:
        error = "Stopped."
    except Exception as exc:
        error = str(exc).splitlines()[0] if str(exc) else "The command failed."
        print()
        print(exc)
    print()
    print("Press Enter to return to the panel.")
    try:
        sys.stdin.readline()
    except KeyboardInterrupt:
        error = error or "Stopped."
    clear_terminal()
    curses.reset_prog_mode()
    curses.curs_set(0)
    stdscr.keypad(True)
    stdscr.erase()
    stdscr.refresh()
    return error


def show_command(stdscr, title, action):
    def wrapped():
        print(title, flush=True)
        print("-" * min(max(len(title), 3), 72), flush=True)
        print(flush=True)
        action()

    return suspend(stdscr, wrapped)


