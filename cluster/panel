def help_screen(stdscr):
    scroll_screen(stdscr, "Keys", HELP_LINES, hint="q back")


def setup_screen(stdscr):
    global USE_COLOR
    signal.signal(signal.SIGINT, signal.default_int_handler)
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    stdscr.keypad(True)
    USE_COLOR = False
    if not curses.has_colors():
        return
    curses.start_color()
    try:
        curses.use_default_colors()
        background = -1
    except curses.error:
        background = curses.COLOR_BLACK
    try:
        curses.init_pair(1, curses.COLOR_CYAN, background)
        curses.init_pair(2, curses.COLOR_GREEN, background)
        curses.init_pair(3, curses.COLOR_YELLOW, background)
        curses.init_pair(4, curses.COLOR_RED, background)
    except curses.error:
        return
    USE_COLOR = True


def load_headline(stdscr, cluster):
    stdscr.erase()
    draw_pieces(stdscr, 0, [("Reading the cluster...", "dim")])
    stdscr.refresh()
    if not cluster.available():
        return [("MicroK8s is not installed on this Pi.", "bad")]
    try:
        nodes = cluster.json(["kubectl", "get", "nodes"], timeout=25).get("items") or []
        pods = cluster.json(["kubectl", "get", "pods", "-A"], timeout=25).get("items") or []
    except Exception as error:
        message = str(error).splitlines()[0] if str(error) else "The cluster did not answer."
        return [(message, "bad")]
    ready_nodes = sum(1 for node in nodes if node_ready(node) == "Ready")
    names = ", ".join(node["metadata"]["name"] for node in nodes) or "no node"
    running = sum(1 for pod in pods if pod_status(pod) == "Running")
    node_kind = "ok" if nodes and ready_nodes == len(nodes) else "warn"
    pod_kind = "ok" if pods and running == len(pods) else "warn"
    pieces = [
        (names, "title"),
        (f"    nodes {ready_nodes}/{len(nodes)}", node_kind),
        (f"    pods running {running}/{len(pods)}", pod_kind),
    ]
    try:
        if compose_neo4j_running():
            pieces.append(("    Compose Neo4j is running", "warn"))
    except Exception:
        pass
    return pieces


def draw_menu(stdscr, headline, notice, selected):
    stdscr.erase()
    height, width = stdscr.getmaxyx()
    if height < 20 or width < 36:
        draw_pieces(stdscr, 0, [("Make this terminal bigger. q quits.", "warn")])
        stdscr.refresh()
        return
    draw_pieces(stdscr, 0, [("Sara cluster", "title")])
    stamp = time.strftime("%H:%M")
    if width > len(stamp) + 2:
        try:
            stdscr.addnstr(0, max(0, width - len(stamp) - 1), stamp, len(stamp), kind_attr("dim"))
        except curses.error:
            pass
    draw_pieces(stdscr, 1, headline)
    draw_pieces(stdscr, 2, [("up/down move  Enter opens  number jumps  r refresh  ? help  q quit", "dim")])
    row = 4
    first = True
    for title, start, end in MENU_SECTIONS:
        if not first and row < height - 1:
            row += 1
        first = False
        if title and row < height - 1:
            draw_pieces(stdscr, row, [(title, "accent")])
            row += 1
        for index in range(start, end):
            if row >= height - 1:
                break
            number, label, detail = MENU[index]
            marker = "> " if index == selected else "  "
            draw_pieces(
                stdscr,
                row,
                [(f"{marker}{number}  {label:<16}", "bold"), (detail, "dim")],
                reverse=index == selected,
            )
            row += 1
    if notice:
        lowered = notice.lower()
        kind = "warn" if lowered.startswith(("not ", "that ", "type ", "stopped", "the command")) else "ok"
        draw_pieces(stdscr, height - 1, [(notice, kind)])
    else:
        draw_pieces(stdscr, height - 1, [(f"{selected + 1} of {len(MENU)}", "dim")])
    stdscr.refresh()


def choose(stdscr, cluster, notice):
    selected = 0
    headline = load_headline(stdscr, cluster)
    while True:
        draw_menu(stdscr, headline, notice, selected)
        stdscr.timeout(-1)
        try:
            key = read_key(stdscr)
        except KeyboardInterrupt:
            return "0"
        if key in (curses.KEY_RESIZE, -1):
            continue
        notice = ""
        if key in (3, 27, ord("q"), ord("Q")):
            return "0"
        if key in (curses.KEY_UP, ord("k")):
            selected = (selected - 1) % len(MENU)
        elif key in (curses.KEY_DOWN, ord("j")):
            selected = (selected + 1) % len(MENU)
        elif key in (10, 13, curses.KEY_ENTER):
            return MENU[selected][0]
        elif key == ord("?"):
            help_screen(stdscr)
        elif key == ord("r"):
            headline = load_headline(stdscr, cluster)
        elif 48 <= key <= 57:
            number = chr(key)
            for item in MENU:
                if item[0] == number:
                    return number
        elif key == curses.KEY_HOME:
            selected = 0
        elif key == curses.KEY_END:
            selected = len(MENU) - 1


def live_map(stdscr, cluster):
    holder = {"title": "Live map", "hide": False, "query": ""}

    def refresh():
        parts = ["Live map", "every 2 seconds"]
        if holder["hide"]:
            parts.append("system pods hidden")
        if holder["query"]:
            parts.append("find " + holder["query"])
        parts.append(time.strftime("%H:%M:%S"))
        holder["title"] = "    ".join(parts)
        nodes = cluster.json(["kubectl", "get", "nodes"]).get("items") or []
        pods = cluster.json(["kubectl", "get", "pods", "-A"]).get("items") or []
        services = cluster.json(["kubectl", "get", "svc", "-A"]).get("items") or []
        ingresses = cluster.json(["kubectl", "get", "ingress", "-A"]).get("items") or []
        lines = build_map(
            nodes, pods, services, ingresses,
            hide_system=holder["hide"], query=holder["query"],
        )
        if compose_neo4j_running():
            lines.append([("", "")])
            lines.append([("Compose Neo4j is running. Do not start a second database.", "warn")])
        return lines

    def on_key(key):
        if key == ord("h"):
            holder["hide"] = not holder["hide"]
            return "home"
        if key == ord("/"):
            holder["query"] = prompt(stdscr, "Find pod: ")
            return "home"
        if key == ord("r"):
            return "refresh"
        return None

    scroll_screen(
        stdscr,
        holder,
        [],
        refresh=refresh,
        on_key=on_key,
        hint="up/down move    left/right scroll    h system    / find    r refresh    q back",
    )


def entry_plain(entry):
    return "".join(text for text, _kind in as_pieces(entry))


def filter_indices(entries, query):
    needle = query.strip().lower()
    if not needle:
        return list(range(len(entries)))
    return [index for index, entry in enumerate(entries) if needle in entry_plain(entry).lower()]


def pick_from(stdscr, title, preamble, entries):
    """Highlight a row. Enter returns its index. q cancels. / filters the list."""
    if not entries:
        scroll_screen(stdscr, title, list(preamble) + ["Nothing to choose."])
        return None
    selected = 0
    vscroll = 0
    typed = ""
    note = ""
    query = ""
    while True:
        visible = filter_indices(entries, query)
        if selected >= len(visible):
            selected = max(0, len(visible) - 1)
        stdscr.erase()
        height, _width = stdscr.getmaxyx()
        draw_pieces(stdscr, 0, [(title, "title")])
        draw_pieces(stdscr, 1, [("up/down highlight    Enter chooses    / find    number jumps    q back", "dim")])
        row = 2
        if query:
            draw_pieces(stdscr, row, [(f"Find: {query}", "dim")])
            row += 1
        for line in preamble[:4]:
            if row >= height - 2:
                break
            draw_pieces(stdscr, row, [(line, "dim")] if isinstance(line, str) else line)
            row += 1
        window = max(1, height - row - 1)
        if not visible:
            draw_pieces(stdscr, row, [("No match. / clears the find.", "warn")])
        else:
            if selected < vscroll:
                vscroll = selected
            elif selected >= vscroll + window:
                vscroll = selected - window + 1
            vscroll = max(0, min(vscroll, max(0, len(visible) - window)))
            for offset in range(window):
                index = vscroll + offset
                if index >= len(visible):
                    break
                draw_pieces(stdscr, row + offset, entries[visible[index]], reverse=index == selected)
        if visible:
            footer = f"{selected + 1} of {len(visible)}"
        else:
            footer = "0 of 0"
        if typed:
            footer = f"Number: {typed}    {footer}"
        if note:
            footer = f"{note}    {footer}"
        draw_pieces(stdscr, height - 1, [(footer, "warn" if note else "dim")])
        stdscr.refresh()
        stdscr.timeout(-1)
        try:
            key = read_key(stdscr)
        except KeyboardInterrupt:
            return None
        if key == 27 and query:
            query = ""
            selected = 0
            typed = ""
            note = ""
            continue
        if key in (3, 27, ord("q"), ord("Q")):
            return None
        if key == ord("/"):
            query = prompt(stdscr, "Find: ")
            selected = 0
            vscroll = 0
            typed = ""
            note = ""
            continue
        if key in (10, 13, curses.KEY_ENTER):
            if not visible:
                note = "No match."
                continue
            if typed:
                if typed.isdigit() and 1 <= int(typed) <= len(entries) and (int(typed) - 1) in visible:
                    return int(typed) - 1
                note = "That number is not on the list."
                continue
            return visible[selected]
        note = ""
        if key in (curses.KEY_BACKSPACE, 127, 8):
            typed = typed[:-1]
            if typed.isdigit() and 1 <= int(typed) <= len(entries) and (int(typed) - 1) in visible:
                selected = visible.index(int(typed) - 1)
        elif 48 <= key <= 57 and len(typed) < 4:
            typed += chr(key)
            if typed.isdigit() and 1 <= int(typed) <= len(entries) and (int(typed) - 1) in visible:
                selected = visible.index(int(typed) - 1)
        elif key in (curses.KEY_UP, ord("k")) and visible:
            selected = max(0, selected - 1)
            typed = ""
        elif key in (curses.KEY_DOWN, ord("j")) and visible:
            selected = min(len(visible) - 1, selected + 1)
            typed = ""
        elif key in (curses.KEY_PPAGE, ord("b")) and visible:
            selected = max(0, selected - window)
            typed = ""
        elif key in (curses.KEY_NPAGE, ord(" "), ord("f")) and visible:
            selected = min(len(visible) - 1, selected + window)
            typed = ""
        elif key in (curses.KEY_HOME, ord("g")):
            selected = 0
            typed = ""
        elif key in (curses.KEY_END, ord("G")) and visible:
            selected = len(visible) - 1
            typed = ""


def busy(stdscr, text):
    stdscr.erase()
    draw_pieces(stdscr, 0, [(text, "dim")])
    stdscr.refresh()


def pick_workload(stdscr, cluster, purpose):
    busy(stdscr, "Reading workloads...")
    deployments = cluster.json(["kubectl", "get", "deploy", "-A"])
    statefulsets = cluster.json(["kubectl", "get", "sts", "-A"])
    rows = workload_rows(deployments, statefulsets)
    preamble = [
        "A Deployment owns stateless pods such as the site and the API.",
        "A StatefulSet owns database pods. Each one keeps its own disk.",
        "You set the count on the controller. Kubernetes adds or removes pods.",
        "DaemonSets such as Traefik stay at one pod per node and are not listed.",
    ]
    if not any(row["namespace"] not in LOCKED_NAMESPACES for row in rows):
        preamble.append("No website workloads yet.")
    entries = []
    for index, row in enumerate(rows, start=1):
        locked = row["namespace"] in LOCKED_NAMESPACES
        pieces = [(
            f"{index:>2}  {row['kind']:<12} {row['namespace']}/{row['name']}"
            f"    ready {row['ready']}/{row['replicas']}",
            "dim" if locked else "",
        )]
        if locked:
            pieces.append(("  locked", "warn"))
        entries.append(pieces)
    chosen = pick_from(stdscr, purpose, preamble, entries)
    if chosen is None:
        return None
    return rows[chosen]


def scale_screen(stdscr, cluster):
    chosen = pick_workload(stdscr, cluster, "Scale")
    if not chosen:
        return ""
    who = f"{chosen['namespace']}/{chosen['name']}"
    decision, message = scale_decision(
        chosen["kind"], chosen["namespace"], chosen["name"], chosen["replicas"], compose_neo4j_running()
    )
    if decision == "locked":
        show_note(stdscr, "Not scaled", message)
        return "Not scaled."
    raw = prompt(stdscr, f"How many pods for {who}? ")
    if not raw or not raw.isdigit():
        return "Type a whole number, 0 or more."
    desired = int(raw)
    decision, message = scale_decision(
        chosen["kind"], chosen["namespace"], chosen["name"], desired, compose_neo4j_running()
    )
    if decision == "reject":
        show_note(stdscr, "Not scaled", message)
        return "Not scaled."
    if decision == "confirm":
        draw_note(stdscr, "Read this before scaling", message)
        typed = prompt(stdscr, "Type YES to continue: ")
        if typed != "YES":
            return "Not changed."
    kind = "deployment" if chosen["kind"] == "Deployment" else "statefulset"
    target = f"{kind}/{chosen['name']}"

    def action():
        if message:
            print(message)
            print()
        print(f"Setting {who} to {desired} pod(s).")
        cluster.visible([
            "kubectl", "scale", target, "-n", chosen["namespace"], f"--replicas={desired}",
        ])
        cluster.visible([
            "kubectl", "rollout", "status", target, "-n", chosen["namespace"], "--timeout=120s",
        ])

    problem = show_command(stdscr, f"Scale {who} to {desired}", action)
    if problem:
        return problem
    return f"{who} set to {desired}."


def events_screen(stdscr, cluster):
    def refresh():
        rows = warning_lines(cluster.json(["kubectl", "get", "events", "-A"]))
        return [[(line, "warn" if line != "No warnings." else "dim")] for line in rows]

    scroll_screen(
        stdscr,
        {"title": "Warnings"},
        [],
        refresh=refresh,
        start="end",
        hint="up/down move    r refresh    q back",
    )


def pick_pod(stdscr, cluster, title):
    busy(stdscr, "Reading pods...")
    data = cluster.json(["kubectl", "get", "pods", "-A"])
    pods = sorted(data.get("items") or [], key=lambda item: (
        item["metadata"]["namespace"], item["metadata"]["name"]
    ))
    entries = []
    for index, pod in enumerate(pods, start=1):
        meta = pod["metadata"]
        status = pod_status(pod)
        entries.append([
            (f"{index:>2}  {meta['namespace']}/{meta['name']}    ", ""),
            (status, status_kind(status)),
        ])
    chosen = pick_from(stdscr, title, [], entries)
    if chosen is None:
        return None
    return pods[chosen]


def logs_screen(stdscr, cluster):
    pod = pick_pod(stdscr, cluster, "Logs")
    if not pod:
        return ""
    meta = pod["metadata"]
    busy(stdscr, "Reading logs...")
    result = cluster.run(
        ["kubectl", "logs", "-n", meta["namespace"], meta["name"], "--tail=120", "--all-containers=true"],
        check=False,
        timeout=30,
    )
    text = ((result.stdout or "") + (result.stderr or "")).strip() or "(no log lines)"
    scroll_screen(
        stdscr,
        f"Logs  {meta['namespace']}/{meta['name']}",
        text.splitlines(),
        start="end",
    )
    return ""


def restart_screen(stdscr, cluster):
    chosen = pick_workload(stdscr, cluster, "Restart")
    if not chosen:
        return ""
    who = f"{chosen['namespace']}/{chosen['name']}"
    if chosen["namespace"] in LOCKED_NAMESPACES:
        show_note(stdscr, "Not restarted", f"{who} belongs to the cluster itself.")
        return "Not restarted."
    typed = prompt(stdscr, f"Restart {who}? Type y: ")
    if typed.lower() != "y":
        return "Not restarted."
    kind = "deployment" if chosen["kind"] == "Deployment" else "statefulset"
    target = f"{kind}/{chosen['name']}"

    def action():
        print(f"Replacing pods for {who}. The Service name stays.")
        cluster.visible(["kubectl", "rollout", "restart", target, "-n", chosen["namespace"]])
        cluster.visible([
            "kubectl", "rollout", "status", target, "-n", chosen["namespace"], "--timeout=120s",
        ])

    problem = show_command(stdscr, f"Restart {who}", action)
    if problem:
        return problem
    return f"Restarted {who}."


def why_screen(stdscr, cluster):
    pod = pick_pod(stdscr, cluster, "Why not ready")
    if not pod:
        return ""
    meta = pod["metadata"]
    busy(stdscr, "Reading the pod...")
    fresh = cluster.json(["kubectl", "get", "pod", "-n", meta["namespace"], meta["name"]])
    lines = []
    for line in pod_reason(fresh):
        kind = "bad" if any(word in line for word in ("False", "Error", "BackOff", "Fail", "OOM")) else ""
        lines.append([(line, kind)])
    scroll_screen(stdscr, f"Why not ready  {meta['namespace']}/{meta['name']}", lines)
    return ""


def status_screen(stdscr, cluster):
    busy(stdscr, "Reading status...")
    result = cluster.run(["status"], check=False, timeout=40)
    text = ((result.stdout or "") + (result.stderr or "")).strip() or "(no status)"
    scroll_screen(stdscr, "Status", text.splitlines())
    return ""


def stop_screen(stdscr, cluster):
    typed = prompt(stdscr, "Type stop to shut the cluster down: ")
    if typed != "stop":
        return "Not stopped."
    problem = show_command(stdscr, "Stop the cluster", lambda: cluster.visible(["stop"]))
    if problem:
        return problem
    return "Cluster stopped."


def start_screen(stdscr, cluster):
    def action():
        print("Starting MicroK8s.")
        cluster.visible(["start"], timeout=180)
        print()
        print("Waiting until the node is Ready.")
        cluster.visible(["status", "--wait-ready"], timeout=180)

    problem = show_command(stdscr, "Start the cluster", action)
    if problem:
        return problem
    return "Cluster is up."


def dispatch(stdscr, cluster, choice):
    screens = {
        "1": live_map,
        "2": scale_screen,
        "3": events_screen,
        "4": logs_screen,
        "5": restart_screen,
        "6": why_screen,
        "7": status_screen,
        "8": stop_screen,
        "9": start_screen,
    }
    screen = screens.get(choice)
    if not screen:
        return ""
    return screen(stdscr, cluster) or ""


def plain_menu():
    print("Sara cluster panel")
    print("This needs your own terminal.")
    print("Open an SSH session and run ~/k8s/panel")
    print("Up and down move. Enter opens. A number jumps. q quits.")
    for number, label, detail in MENU:
        print(f"  {number}  {label}    {detail}".rstrip())


def main(stdscr):
    setup_screen(stdscr)
    stdscr.erase()
    draw_pieces(stdscr, 0, [("Opening the panel...", "dim")])
    stdscr.refresh()
    cluster = Cluster()
    notice = ""
    while True:
        choice = choose(stdscr, cluster, notice)
        notice = ""
        if choice == "0":
            return
        try:
            notice = dispatch(stdscr, cluster, choice) or ""
        except KeyboardInterrupt:
            notice = ""
        except RuntimeError as error:
            notice = str(error).splitlines()[0] if str(error) else "That did not work."


if __name__ == "__main__":
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        plain_menu()
        sys.exit(0)
    try:
        curses.wrapper(main)
        print("Panel closed.")
    except KeyboardInterrupt:
        print()
        print("Panel closed.")
        sys.exit(0)
